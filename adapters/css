#!/bin/sh
# vestiary adapter: generic CSS custom properties
# Emits: <outdir>/vestiary.css. Consumers may link or import the stable
# runtime path at ~/.config/livery/current/css/vestiary.css.
set -eu

FRAGMENT_NAME="vestiary.css"

render() {
  manifest=$1
  outdir=$2
  [ -r "$manifest" ] || { echo "render: manifest unreadable: $manifest" >&2; exit 1; }
  schema_version=$(jq -r '.schemaVersion // empty' "$manifest" 2>/dev/null) || {
    echo "render: manifest is not valid JSON" >&2
    exit 1
  }
  if [ "$schema_version" != "3" ]; then
    echo "render: unsupported Look manifest schemaVersion $schema_version — skipping" >&2
    exit 0
  fi
  jq -e '
    .kind == "look-manifest"
      and (.variant == "dark" or .variant == "light")
      and (.ui | type == "object")
      and (.signals | type == "object")
      and (.terminal | type == "object")
  ' "$manifest" >/dev/null || {
    echo "render: unsupported or malformed Look manifest" >&2
    exit 1
  }
  mkdir -p "$outdir"

  jq -r '
    def kebab:
      gsub("(?<letter>[A-Z])"; "-\(.letter | ascii_downcase)")
      | ascii_downcase;
    def property($path):
      "--vestiary-" + ($path | map(if type == "number" then tostring else kebab end) | join("-"));
    def declarations($path):
      if type == "object" and has("hex") and has("rgb") then
        "  \(property($path)): \(.hex);",
        "  \(property($path))-rgb: \(.rgb | join(" "));"
      elif type == "object" then
        to_entries[] as $entry
        | $entry.value
        | declarations($path + [$entry.key])
      elif type == "array" then
        to_entries[] as $entry
        | $entry.value
        | declarations($path + [$entry.key])
      elif type == "string" then
        "  \(property($path)): \(. | @json);"
      elif type == "number" or type == "boolean" then
        "  \(property($path)): \(.);"
      else empty
      end;

    "/* Generated by Vestiary. Do not edit. */",
    ":root {",
    "  color-scheme: \(.variant);",
    "  --vestiary-variant: \(.variant | @json);",
    (. as $manifest
      | ["ui", "signals", "terminal", "effects", "fonts"][] as $domain
      | $manifest[$domain]
      | declarations([$domain])),
    "}"
  ' "$manifest" > "$outdir/$FRAGMENT_NAME" || {
    echo "render: jq failed" >&2
    exit 1
  }
  echo "rendered CSS artifact: $outdir/$FRAGMENT_NAME"
}

validate() {
  outdir=$1
  fragment="$outdir/$FRAGMENT_NAME"
  [ -r "$fragment" ] || { echo "validate: artifact missing: $fragment" >&2; exit 1; }
  grep -Eq '^:root \{$' "$fragment" \
    && grep -Eq '^  color-scheme: (dark|light);$' "$fragment" \
    && grep -Eq '^  --vestiary-ui-background: #[0-9a-f]{6};$' "$fragment" \
    && grep -Eq '^  --vestiary-terminal-ansi-15: #[0-9a-f]{6};$' "$fragment" \
    && [ "$(tail -n 1 "$fragment")" = '}' ] || {
      echo "validate: malformed CSS artifact" >&2
      exit 1
    }
  echo "CSS artifact validates"
}

reload() {
  echo "CSS reload delegated to consumers"
}

loader_check() {
  echo "loader n/a: CSS artifact has no required loader"
}

case "${1:-}" in
  render)       [ $# -eq 3 ] || { echo "usage: css render <manifest> <outdir>" >&2; exit 2; }
                render "$2" "$3" ;;
  validate)     [ $# -eq 2 ] || { echo "usage: css validate <outdir>" >&2; exit 2; }
                validate "$2" ;;
  reload)       [ $# -eq 2 ] || { echo "usage: css reload <profiledir>" >&2; exit 2; }
                reload ;;
  loader-check) [ $# -eq 1 ] || { echo "usage: css loader-check" >&2; exit 2; }
                loader_check ;;
  *)            echo "unknown verb: ${1:-<none>} (render|validate|reload|loader-check)" >&2
                exit 2 ;;
esac
