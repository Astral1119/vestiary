  "invariants": [
    {"identity": "exact-noncommutative-pass-order", "description": "The production renderer executes the image layer, two target passes, and final composite in exact authored order; swapping the noncommutative target passes changes the accepted pixels."},
    {"identity": "exact-backend-pixel-output", "description": "Full-frame hashes, a normalized center probe, and a normalized center region match the exact backend-specific reference before and after reload."},
    {"identity": "translucent-final-composition", "description": "The final full-frame pass uses effective translucent blending while the image layer and intermediate target passes use effective normal blending."},
    {"identity": "bounded-pass-evidence", "description": "Ordered pass evidence is complete, has no truncated passes or tokens, and identifies authored targets, actual draw targets, inputs, previous-input use, and effective blending."},
    {"identity": "physical-intermediate-lifecycle", "description": "Exactly two effect-owned framebuffer and texture objects remain live during a session without per-frame churn."},
    {"identity": "reload-isolation", "description": "Reload releases both old effect intermediates, creates two new intermediates, and reproduces the exact pass graph and pixels without stale reuse."},
    {"identity": "global-stop-live-zero", "description": "After renderer teardown, global effect framebuffer and texture live counts are zero and cumulative allocations equal deallocations."},
    {"identity": "conservative-full-frame-damage", "description": "A property change with unknown affected objects is explicitly represented as conservative unknown damage expanded to the full frame."},
    {"identity": "unknown-effect-fail-live", "description": "The effect scene remains conservatively classified as legacy continuous rather than claiming an unsupported bounded lifecycle."},
    {"identity": "deterministic-puppet-generation", "description": "A manifest-bound generator and parameter file reproduce byte-exact masked and unmasked MDLV0023 models plus base and mask TEXV0005 textures before each adapter run."},
    {"identity": "bounded-mdlv0023-structure", "description": "Generation validates one mesh, eight normalized root-weighted vertices, bounded 16-bit indices, exact source and target parts, one optional mask, and one MDLS0004 root bone before rendering."},
    {"identity": "stencil-mask-execution", "description": "The masked fixture loads one mask and executes exactly one stencil mask pass per draw while the byte-equivalent unmasked comparison executes none."},
    {"identity": "masked-unmasked-pixel-oracle", "description": "Backend-specific full hashes, source and target probes, and source and target regions keep the source identical while proving that the target is excluded only by stencil composition; masked reload reproduces the exact output."}
