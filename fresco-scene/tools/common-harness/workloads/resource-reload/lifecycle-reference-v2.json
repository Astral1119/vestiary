{
  "schemaVersion": 2,
  "workload": "resource-reload",
  "profile": "lifecycle-matched-control",
  "required": {
    "createDestroyIterations": 3,
    "reloadIterations": 3,
    "generationsPerIteration": 2,
    "completionBarriersPerIteration": 2,
    "liveGenerationsAfterStop": 0,
    "programPublicationDeletionBalance": true,
    "ownedProcessesAfterStop": 0
  },
  "resourceCriteria": {
    "processes": {"before": 0, "after": 0, "peakAtLeast": 1},
    "childProcesses": {"before": 0, "after": 0, "peakAtLeast": 0},
    "rssBytes": {"before": 0, "after": 0, "peakAtLeast": 1},
    "threads": {"before": 0, "after": 0, "peakAtLeast": 1},
    "fileDescriptors": {"before": 0, "after": 0, "peakAtLeast": 1},
    "trackedPrograms": {"before": 0, "after": 0, "peakAtLeast": 1},
    "trackedRendererAllocations": {"before": 0, "after": 0, "peakAtLeast": 0}
  },
  "leakCriteria": {
    "normalizationVersion": "apple-framework-matched-control-v1",
    "controlProtocol": {
      "assignment": "lifecycle-appkit-window-control",
      "eventTypes": ["hello", "ready", "stopped"],
      "loads": 1
    },
    "allowedNormalizedSignatures": [
      {"identity": "apple-appintents", "stackToken": "AppIntents"},
      {"identity": "apple-linkservices", "stackToken": "LinkServices"},
      {"identity": "apple-nsxpcconnection", "stackToken": "NSXPCConnection"}
    ],
    "forbiddenAttributionTokens": [
      "FrescoScene", "fresco-scene", "WallpaperEngine", "OpenGL",
      "libGLES", "libEGL", "ANGLE", "Metal.framework", "AGXMetal", "MTL"
    ],
    "requiredControlSignatureRelation": "exact-allowed-set",
    "requiredSubjectSignatureRelation": "subset-of-control",
    "requiredSubjectTotalsRelation": "objects-and-bytes-not-greater-than-control",
    "maximumUnknownGroups": 0,
    "maximumForbiddenAttributionGroups": 0,
    "maximumSubjectOnlySignatures": 0
  },
  "deviceLoss": {
    "status": "unavailable",
    "reason": "protocol version 1 and both compatibility backends expose no supported device-loss injection"
  },
  "driverGpuResources": {
    "status": "unavailable",
    "reason": "native OpenGL and ANGLE expose no complete count of driver-private GPU allocations"
  },
  "metricDefinitions": {
    "trackedPrograms": "maximum programCacheEntries reported by ready evidence",
    "trackedRendererAllocations": "maximum sum of live counters across renderAllocations classes reported by metrics evidence",
    "normalizedLeakGroup": "one complete STACK OF block from macOS leaks --atExit, bound by SHA-256 and classified only by the exact versioned stack tokens",
    "matchedControl": "one load of the static-no-media minimal AppKit-window project through the same helper binary, environment, protocol, and leak tool"
  }
}
