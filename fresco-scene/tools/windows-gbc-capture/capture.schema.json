{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestiary.local/fresco-scene/gbc-capture.schema.json",
  "title": "Fresco GBC secondary-motion capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "wallpaperID",
    "scenePackage",
    "trial",
    "requestedWallpaperFps",
    "requestedCaptureFps",
    "captureBackend",
    "durationSeconds",
    "desktop",
    "capture",
    "roi",
    "processName",
    "files",
    "host",
    "tools"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "wallpaperID": { "const": "3448290956" },
    "scenePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "trial": { "enum": ["idle", "cursor-step", "cursor-sweep"] },
    "requestedWallpaperFps": { "enum": [30, 60, 120] },
    "requestedCaptureFps": { "type": "integer", "minimum": 60, "maximum": 240 },
    "captureBackend": { "enum": ["ddagrab", "gdigrab"] },
    "durationSeconds": { "type": "number", "minimum": 10, "maximum": 30 },
    "desktop": { "$ref": "#/$defs/rectangle" },
    "capture": { "$ref": "#/$defs/rectangle" },
    "roi": { "$ref": "#/$defs/rectangle" },
    "processName": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "presentMon",
        "events",
        "ffmpegLog",
        "ffmpegTranscodeLog",
        "presentMonLog",
        "presentMonErrorLog"
      ],
      "properties": {
        "video": { "const": "capture.mkv" },
        "presentMon": { "const": "presentmon.csv" },
        "events": { "const": "events.csv" },
        "ffmpegLog": { "const": "ffmpeg.log" },
        "ffmpegTranscodeLog": { "const": "ffmpeg-transcode.log" },
        "presentMonLog": { "const": "presentmon.log" },
        "presentMonErrorLog": { "const": "presentmon-error.log" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": true,
      "required": ["capturedAtUtc", "computerName", "os", "videoControllers"],
      "properties": {
        "capturedAtUtc": { "type": "string", "format": "date-time" },
        "computerName": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "videoControllers": { "type": "array", "minItems": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg", "ffprobe", "presentMon"],
      "properties": {
        "ffmpeg": { "type": "string", "minLength": 1 },
        "ffprobe": { "type": "string", "minLength": 1 },
        "presentMon": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
