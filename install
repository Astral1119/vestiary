#!/bin/sh
set -eu

REPO_ROOT=$(cd "$(dirname "$0")" && pwd)
. "$REPO_ROOT/setup/receipt.sh"
. "$REPO_ROOT/setup/plan.sh"
USER_CONFIG_ROOT=${VESTIARY_USER_CONFIG_ROOT:-"$HOME/.config"}

WIRE=ask
VSCODE=ask
DETECTED_TARGETS=ask
MODE=install
SELECTION_PATH=
LEGACY_CHOICE_FLAGS=no
while [ "$#" -gt 0 ]; do
  case $1 in
    --wire) WIRE=yes; LEGACY_CHOICE_FLAGS=yes ;;
    --no-wire) WIRE=no; LEGACY_CHOICE_FLAGS=yes ;;
    --with)
      [ "${2:-}" = vscode ] || {
        echo "install: --with currently accepts only 'vscode'" >&2
        exit 2
      }
      VSCODE=yes
      LEGACY_CHOICE_FLAGS=yes
      shift
      ;;
    --without)
      [ "${2:-}" = vscode ] || {
        echo "install: --without currently accepts only 'vscode'" >&2
        exit 2
      }
      VSCODE=no
      LEGACY_CHOICE_FLAGS=yes
      shift
      ;;
    --enable-detected) DETECTED_TARGETS=yes; LEGACY_CHOICE_FLAGS=yes ;;
    --disable-detected) DETECTED_TARGETS=no; LEGACY_CHOICE_FLAGS=yes ;;
    --plan)
      [ "$MODE" = install ] || {
        echo "install: choose exactly one of --plan or --apply" >&2
        exit 2
      }
      MODE=plan
      ;;
    --apply)
      [ -n "${2:-}" ] || {
        echo "install: --apply requires a plan or selection file" >&2
        exit 2
      }
      [ "$MODE" = install ] || {
        echo "install: choose exactly one of --plan or --apply" >&2
        exit 2
      }
      MODE=apply
      SELECTION_PATH=$2
      shift
      ;;
    --help)
      cat <<'EOF'
usage: ./install --plan
       ./install --apply <plan-or-selection.json>
       ./install [--wire|--no-wire] [--enable-detected|--disable-detected]
                 [--with vscode|--without vscode]

Detected loader wiring and the Visual Studio Code integration are offered in
interactive installs. CSS output is always enabled. The flags make the other
choices explicit.
EOF
      exit 0
      ;;
    *)
      echo "install: unknown option: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$MODE" != install ] && [ "$LEGACY_CHOICE_FLAGS" = yes ]; then
  echo "install: --plan and --apply cannot be combined with interactive choice flags" >&2
  exit 2
fi

TARGETS_CONFIG=${LIVERY_TARGETS_CONFIG:-"${LIVERY_CONFIG_ROOT:-$HOME/.config}/vestiary/targets.json"}
LIVERY_RUNTIME=${LIVERY_RUNTIME_ROOT:-"${LIVERY_CONFIG_ROOT:-$HOME/.config}/livery"}
FRESH_INSTALL=no
if [ ! -e "$VESTIARY_RECEIPT_PATH" ] && [ ! -e "$LIVERY_RUNTIME" ]; then
  FRESH_INSTALL=yes
fi

if [ "$MODE" = plan ]; then
  emit_setup_plan "$TARGETS_CONFIG" "$LIVERY_RUNTIME" "$VESTIARY_RECEIPT_PATH"
  exit
fi

required_missing=0

report_dependency() {
  dependency=$1
  kind=$2
  consequence=$3

  # ghostty ships its CLI inside the app bundle, usually off PATH
  if [ "$dependency" = ghostty ] && [ -x "${LIVERY_GHOSTTY_BIN:-/Applications/Ghostty.app/Contents/MacOS/ghostty}" ]; then
    status=found
    consequence=''
    printf '  %-14s %-10s %-8s %s\n' "$dependency" "$kind" "$status" "$consequence"
    return
  fi
  if command -v "$dependency" >/dev/null 2>&1; then
    status=found
    consequence=''
  else
    status=missing
    if [ "$kind" = required ]; then
      required_missing=1
    fi
  fi

  printf '  %-14s %-10s %-8s %s\n' "$dependency" "$kind" "$status" "$consequence"
}

echo "dependencies"
printf '  %-14s %-10s %-8s %s\n' "command" "need" "status" "when missing"
report_dependency jq required "required for bootstrap"
report_dependency swiftc required "livery, lvry, and fresco compile Swift helpers"
report_dependency cargo optional "matugen fallback build (arm64 macs download a prebuilt)"
report_dependency ffmpeg optional "scene lock images + video frame extraction"
report_dependency tmux optional "the tmux surface won't be themed"
report_dependency nvim optional "the nvim surface won't be themed"
report_dependency ghostty optional "the ghostty surface won't be themed"
report_dependency sketchybar optional "the sketchybar surface won't be themed"
report_dependency borders optional "the borders surface won't be themed"
report_dependency yabai optional "borders loader rides yabairc"
report_dependency cava optional "fresco audio/now-playing"
report_dependency media-control optional "fresco audio/now-playing"
report_dependency steamcmd optional "workshop downloads (also needs Wallpaper Engine on Steam)"

if [ "$required_missing" -ne 0 ]; then
  echo "install: required dependencies are missing" >&2
  exit 1
fi

if [ "$MODE" = apply ]; then
  apply_setup_selection "$SELECTION_PATH" "$TARGETS_CONFIG"
else
  receipt_init
fi

# fonts (contract §2.4.3): the map names every family the shipped surfaces
# need. Font casks install per-user, so this check is per-account. Missing
# fonts never fail the install — surfaces fall back per §2.4.1.
FONTS_MAP="$REPO_ROOT/contract/fonts-map.json"
echo ""
echo "fonts"
if ! command -v osascript >/dev/null 2>&1; then
  echo "  osascript unavailable — skipping the font check"
else
  installed_families=$(osascript -l JavaScript -e \
    'ObjC.import("AppKit"); $.NSFontManager.sharedFontManager.availableFontFamilies.js.map(function(f){return f.js}).join("\n")' \
    2>/dev/null || true)
  missing_casks=''

  family_installed() {
    printf '%s\n' "$installed_families" | grep -Fxq "$1"
  }

  while IFS="$(printf '\t')" read -r family cask why; do
    [ -n "$family" ] || continue
    if family_installed "$family"; then
      printf '  %-30s %-8s\n' "$family" found
    else
      printf '  %-30s %-8s %s (cask: %s)\n' "$family" missing "$why" "$cask"
      missing_casks="$missing_casks $cask"
    fi
  done <<FONTS
$(jq -r '.fonts[] | [.family, .cask, .why] | @tsv' "$FONTS_MAP")
FONTS

  while IFS="$(printf '\t')" read -r name path cask why; do
    [ -n "$name" ] || continue
    if [ -d "$path" ]; then
      printf '  %-30s %-8s\n' "$name" found
    else
      printf '  %-30s %-8s %s (cask: %s)\n' "$name" missing "$why" "$cask"
      missing_casks="$missing_casks $cask"
    fi
  done <<FONTS
$(jq -r '.apps[] | [.name, .path, .cask, .why] | @tsv' "$FONTS_MAP")
FONTS

  # families the user chose in ~/.config/livery/fonts.json that the map
  # doesn't know: report-only, no cask to offer.
  user_fonts="$USER_CONFIG_ROOT/livery/fonts.json"
  if [ -r "$user_fonts" ]; then
    while IFS= read -r family; do
      [ -n "$family" ] || continue
      if ! family_installed "$family" \
        && ! jq -e --arg f "$family" '[.fonts[].family] | index($f)' "$FONTS_MAP" >/dev/null; then
        printf '  %-30s %-8s %s\n' "$family" missing \
          "chosen in fonts.json — no known cask, install by hand"
      fi
    done <<FONTS
$(jq -r '[.[]?.family // empty] | unique | .[]' "$user_fonts" 2>/dev/null || true)
FONTS
  fi

  if [ -n "$missing_casks" ]; then
    if command -v brew >/dev/null 2>&1; then
      want=n
      if [ "$MODE" != apply ] && [ -t 0 ]; then
        printf '  install the missing casks via brew?%s [y/N] ' "$missing_casks"
        read -r want || want=n
      fi
      case $want in
        y|Y)
          # Cask names are unquoted by design.
          # shellcheck disable=SC2086
          brew install --cask $missing_casks || echo "  brew install had errors; fonts above stay missing"
          ;;
      esac
    else
      echo "  brew unavailable — install the casks above by hand"
    fi
  fi
fi

MATUGEN="$REPO_ROOT/livery/tools/bin/matugen"
if [ -x "$MATUGEN" ]; then
  printf '\nmatugen: '
  "$MATUGEN" --version
else
  echo ""
  echo "matugen: fetching pinned release"
  # arm64 downloads a prebuilt asset; other platforms build via cargo.
  "$REPO_ROOT/livery/tools/fetch-matugen" || true
fi

for shim in \
  "livery:livery/liveryctl" \
  "lvry:livery/lvry" \
  "fresco:fresco/fresco"; do
  target=${shim#*:}
  if [ ! -x "$REPO_ROOT/$target" ]; then
    echo "install: corrupt clone: missing executable $REPO_ROOT/$target" >&2
    exit 1
  fi
done

configure_fresh_targets() {
  [ "$FRESH_INSTALL" = yes ] || return 0
  [ ! -e "$TARGETS_CONFIG" ] || return 0

  enabled_tmp=$(mktemp "${TMPDIR:-/tmp}/vestiary-targets-enabled.XXXXXX")
  disabled_tmp=$(mktemp "${TMPDIR:-/tmp}/vestiary-targets-disabled.XXXXXX")

  echo ""
  echo "target selection"
  while IFS="$(printf '\t')" read -r id adapter_path metadata; do
    [ -n "$id" ] || continue
    if [ -r "$metadata" ]; then
      label=$(jq -r '.displayName' "$metadata")
      command_name=$(jq -r '.detect.command // empty' "$metadata")
      application=$(jq -r '.detect.application // empty' "$metadata")
    else
      label=$id
      command_name=
      application=
    fi

    if [ "$id" = css ]; then
      printf '%s\n' "$id" >> "$enabled_tmp"
      echo "  $label: enabled (portable artifact)"
      continue
    fi

    detected=no
    if [ -n "$command_name" ] && command -v "$command_name" >/dev/null 2>&1; then
      detected=yes
    elif [ -n "$application" ] \
      && { [ -d "/Applications/$application" ] || [ -d "$HOME/Applications/$application" ]; }; then
      detected=yes
    fi

    want=n
    if [ "$detected" = yes ]; then
      if [ "$DETECTED_TARGETS" = yes ]; then
        want=y
      elif [ "$DETECTED_TARGETS" = ask ] && [ -t 0 ]; then
        printf '  %s detected; enable its Vestiary adapter? [y/N] ' "$label"
        read -r want || want=n
      fi
    fi
    case $want in
      y|Y)
        printf '%s\n' "$id" >> "$enabled_tmp"
        echo "  $label: enabled"
        ;;
      *)
        printf '%s\n' "$id" >> "$disabled_tmp"
        if [ "$detected" = yes ]; then
          echo "  $label: disabled"
        else
          echo "  $label: disabled (not detected)"
        fi
        ;;
    esac
  done <<EOF
$(setup_discovered_adapters)
EOF

  mkdir -p "$(dirname "$TARGETS_CONFIG")"
  targets_tmp=$(mktemp "${TMPDIR:-/tmp}/vestiary-targets.XXXXXX")
  jq -n --rawfile enabled "$enabled_tmp" --rawfile disabled "$disabled_tmp" '
    {schemaVersion: 1,
     enabled: ($enabled | split("\n") | map(select(length > 0))),
     disabled: ($disabled | split("\n") | map(select(length > 0)))}
  ' > "$targets_tmp"
  mv "$targets_tmp" "$TARGETS_CONFIG"
  rm -f "$enabled_tmp" "$disabled_tmp"
  echo "  selection recorded at $TARGETS_CONFIG"
}

configure_fresh_targets

SHIM_DIR=${VESTIARY_SHIM_DIR:-"$HOME/.local/bin"}
mkdir -p "$SHIM_DIR"
expected_shim=$(mktemp "${TMPDIR:-/tmp}/vestiary-install.XXXXXX")
trap 'rm -f "$expected_shim"' 0
trap 'exit 1' HUP INT TERM

echo ""
echo "command shims"
for shim in \
  "livery:livery/liveryctl" \
  "lvry:livery/lvry" \
  "fresco:fresco/fresco"; do
  name=${shim%%:*}
  target=${shim#*:}
  shim_path="$SHIM_DIR/$name"
  printf '#!/bin/sh\nexec "%s/%s" "$@"\n' "$REPO_ROOT" "$target" > "$expected_shim"

  if [ -e "$shim_path" ] || [ -L "$shim_path" ]; then
    if cmp -s "$expected_shim" "$shim_path"; then
      chmod +x "$shim_path"
      receipt_record "$(jq -n --arg id "$name" --arg path "$shim_path" \
        --arg digest "$(file_digest "$shim_path")" \
        '{kind: "shim", id: $id, path: $path, digest: $digest}')"
      echo "  $name: ok"
      continue
    fi

    existing_target=$(sed -n 's/^exec "\([^"]*\)" "\$@"$/\1/p' "$shim_path" 2>/dev/null || true)
    # This matches the literal prefix emitted by the pre-receipt installer.
    # shellcheck disable=SC2016
    legacy_home_prefix='$HOME/'
    case $existing_target in
      "$legacy_home_prefix"*)
        legacy_target="$HOME/${existing_target#"$legacy_home_prefix"}"
        if [ "$legacy_target" = "$REPO_ROOT/$target" ]; then
          cp "$expected_shim" "$shim_path"
          chmod +x "$shim_path"
          receipt_record "$(jq -n --arg id "$name" --arg path "$shim_path" \
            --arg digest "$(file_digest "$shim_path")" \
            '{kind: "shim", id: $id, path: $path, digest: $digest}')"
          echo "  $name: upgraded legacy shim -> $REPO_ROOT/$target"
          continue
        fi
        ;;
    esac
    if [ -z "$existing_target" ]; then
      existing_target="unrecognized content at $shim_path"
    fi
    echo "  $name: kept existing target: $existing_target"
    echo "    remove $shim_path if you want it regenerated"
    continue
  fi

  cp "$expected_shim" "$shim_path"
  chmod +x "$shim_path"
  receipt_record "$(jq -n --arg id "$name" --arg path "$shim_path" \
    --arg digest "$(file_digest "$shim_path")" \
    '{kind: "shim", id: $id, path: $path, digest: $digest}')"
  echo "  $name: installed -> $REPO_ROOT/$target"
done

case ":${PATH:-}:" in
  *":$SHIM_DIR:"*) ;;
  *) echo "warning: $SHIM_DIR is not in PATH" >&2 ;;
esac

# Loader wiring lives here rather than behind a new adapter verb: the
# contract's verb set is frozen, and editing user configs is installer
# policy, not adapter mechanism. Wiring only runs when asked (a TTY yes,
# or --wire); the report alone stays the non-interactive behavior.
append_line() {
  target=$1
  line=$2
  id=$3
  if [ -f "$target" ] && grep -Fxq "$line" "$target"; then
    echo "  $id: loader line already present; left user-owned"
    return
  fi
  mkdir -p "$(dirname "$target")"
  [ -f "$target" ] && [ -n "$(tail -c 1 "$target" 2>/dev/null)" ] && printf '\n' >> "$target"
  printf '%s\n' "$line" >> "$target"
  receipt_record "$(jq -n --arg id "$id" --arg path "$target" --arg line "$line" \
    '{kind: "loader-line", id: $id, path: $path, line: $line}')"
}

install_managed_file() {
  target=$1
  id=$2
  source=$3
  backup_json=null
  backup_digest_json=null
  owned_before=no
  had_file=no

  if receipt_owns_path managed-file "$target"; then
    owned_before=yes
  fi
  if [ -f "$target" ]; then
    had_file=yes
  fi

  if [ "$owned_before" = yes ] && [ "$had_file" = yes ]; then
    owned_digest=$(jq -r --arg path "$target" '
      [.resources[] | select(.kind == "managed-file" and .path == $path)][0].digest
    ' "$VESTIARY_RECEIPT_PATH")
    if [ "$(file_digest "$target")" != "$owned_digest" ]; then
      echo "  $id: kept modified file at $target"
      return 1
    fi
  fi

  mkdir -p "$(dirname "$target")"
  if [ "$had_file" = yes ] && [ "$owned_before" = no ]; then
    mkdir -p "$VESTIARY_BACKUP_DIR"
    prior_digest=$(file_digest "$target")
    backup="$VESTIARY_BACKUP_DIR/$id.$prior_digest"
    if [ ! -e "$backup" ]; then
      cp "$target" "$backup"
    fi
    backup_json=$(jq -Rn --arg value "$backup" '$value')
    backup_digest_json=$(jq -Rn --arg value "$prior_digest" '$value')
  fi

  cp "$source" "$target"
  if [ "$owned_before" = no ] && [ "$had_file" = yes ]; then
    receipt_record "$(jq -n --arg id "$id" --arg path "$target" \
      --arg digest "$(file_digest "$target")" \
      --argjson backup "$backup_json" --argjson backupDigest "$backup_digest_json" \
      '{kind: "managed-file", id: $id, path: $path, digest: $digest,
        backup: $backup, backupDigest: $backupDigest}')"
  else
    receipt_record "$(jq -n --arg id "$id" --arg path "$target" \
      --arg digest "$(file_digest "$target")" \
      '{kind: "managed-file", id: $id, path: $path, digest: $digest}')"
  fi
}

wire_loader() {
  case $1 in
    tmux)
      append_line "$USER_CONFIG_ROOT/tmux/tmux.conf" \
        'source-file -q ~/.config/livery/current/tmux/livery.conf' tmux ;;
    ghostty)
      append_line "$USER_CONFIG_ROOT/ghostty/config" \
        'config-file = ?../livery/current/ghostty/livery.conf' ghostty ;;
    borders)
      # The generated yabairc must expand HOME when yabai reads it.
      # shellcheck disable=SC2016
      append_line "$USER_CONFIG_ROOT/yabai/yabairc" \
        'source "$HOME/.config/livery/current/borders/borders.args"' borders ;;
    sketchybar)
      shim="$USER_CONFIG_ROOT/sketchybar/colors.lua"
      managed_tmp=$(mktemp "${TMPDIR:-/tmp}/vestiary-loader.XXXXXX")
      cat > "$managed_tmp" <<'LUA'
local root = os.getenv("HOME") .. "/.config/livery"
local current = root .. "/current/sketchybar/colors.lua"
local fallback = root .. "/default/sketchybar/colors.lua"

local ok, colors = pcall(dofile, current)
if ok then return colors end

return dofile(fallback)
LUA
      if ! install_managed_file "$shim" sketchybar-colors "$managed_tmp"; then
        rm -f "$managed_tmp"
        return 1
      fi
      rm -f "$managed_tmp"
      ;;
    nvim)
      plugins="$USER_CONFIG_ROOT/nvim/lua/plugins"
      if [ ! -d "$plugins" ]; then
        echo "  nvim: no lazy.nvim plugins dir at $plugins — wire it by hand"
        return 1
      fi
      managed_tmp=$(mktemp "${TMPDIR:-/tmp}/vestiary-loader.XXXXXX")
      cat > "$managed_tmp" <<LUA
return {
  {
    dir = "$REPO_ROOT/livery.nvim",
    name = "livery.nvim",
    lazy = false,
    priority = 999,
    config = function()
      require("livery").setup()
    end,
  },
}
LUA
      if ! install_managed_file "$plugins/livery.lua" nvim-plugin "$managed_tmp"; then
        rm -f "$managed_tmp"
        return 1
      fi
      rm -f "$managed_tmp"
      ;;
    *) return 1 ;;
  esac
}

echo ""
echo "loader wiring"
enabled_targets=$("$REPO_ROOT/livery/liveryctl" targets | awk '$2 == "enabled" {print $1}')
while IFS="$(printf '\t')" read -r name adapter metadata; do
  [ -n "$name" ] || continue
  printf '%s\n' "$enabled_targets" | grep -Fxq "$name" || continue
  printf '\n%s:\n' "$name"
  # loader failures are guidance, not installer failures.
  if "$adapter" loader-check; then
    continue
  fi
  want=n
  if [ "$WIRE" = yes ]; then
    want=y
  elif [ "$WIRE" = ask ] && [ -t 0 ]; then
    printf '  wire it now? [y/N] '
    read -r want || want=n
  fi
  case $want in
    y|Y)
      if wire_loader "$name"; then
        "$adapter" loader-check || true
      fi
      ;;
  esac
done <<EOF
$(setup_discovered_adapters)
EOF

echo ""
echo "integrations"
if ! command -v code >/dev/null 2>&1; then
  echo "  vscode: not detected"
elif code --list-extensions 2>/dev/null | grep -Fxiq 'vestiary.vestiary-vscode'; then
  if receipt_owns_extension code vestiary.vestiary-vscode; then
    echo "  vscode: managed extension already installed"
  elif [ "$VSCODE" = yes ]; then
    vscode_version=$(code --list-extensions --show-versions 2>/dev/null \
      | sed -n 's/^vestiary\.vestiary-vscode@//Ip' | head -1)
    [ -n "$vscode_version" ] \
      || vscode_version=$(jq -r '.version' "$REPO_ROOT/integrations/vscode/package.json")
    receipt_record "$(jq -n --arg id vestiary.vestiary-vscode --arg host code \
      --arg version "$vscode_version" \
      '{kind:"editor-extension", id:$id, host:$host, version:$version,
        installedByVestiary:false, origin:"explicit-adoption"}')"
    echo "  vscode: existing extension accepted as managed"
  else
    echo "  vscode: extension already installed; left user-owned"
  fi
else
  want=n
  if [ "$VSCODE" = yes ]; then
    want=y
  elif [ "$VSCODE" = ask ] && [ -t 0 ]; then
    printf '  install the Vestiary extension for Visual Studio Code? [y/N] '
    read -r want || want=n
  fi
  case $want in
    y|Y)
      if ! command -v npm >/dev/null 2>&1; then
        echo "  vscode: npm is required to package the development extension" >&2
      else
        vscode_version=$(jq -r '.version' "$REPO_ROOT/integrations/vscode/package.json")
        vscode_vsix="$REPO_ROOT/integrations/vscode/vestiary-vscode-$vscode_version.vsix"
      fi
      if command -v npm >/dev/null 2>&1 \
        && (cd "$REPO_ROOT/integrations/vscode" && npm run package) \
        && code --install-extension \
          "$vscode_vsix"; then
        receipt_record "$(jq -n --arg id vestiary.vestiary-vscode --arg host code \
          --arg version "$vscode_version" \
          '{kind: "editor-extension", id: $id, host: $host,
            version: $version, installedByVestiary: true}')"
        echo "  vscode: installed and recorded"
      elif command -v npm >/dev/null 2>&1; then
        echo "  vscode: extension install failed" >&2
      fi
      ;;
    *) echo "  vscode: available; rerun with --with vscode to install" ;;
  esac
fi

# permissions command -v can't see: TCC grants and yabai's own setup.
cat <<'EOF'

system permissions
  audio-reactive wallpapers need a one-time Screen & System Audio
  Recording grant to ~/Applications/Fresco.app. run `fresco
  audio-permission` for the exact steps. ungranted, wallpapers play
  silent; fresco never raises the prompt in the background.
EOF
if command -v yabai >/dev/null 2>&1; then
  cat <<'EOF'
  yabai's scripting addition (SIP + sudoers, see the yabai wiki) belongs
  to your yabai setup. vestiary adapters only query yabai and don't
  need it; the borders loader rides yabairc.
EOF
fi

cat <<'EOF'

next steps
  livery apply default
  wire any missing loader lines from the report above
  livery apply <profile>

  livery list shows profiles
  fresco set <path-or-workshop-id> starts a live wallpaper
EOF
