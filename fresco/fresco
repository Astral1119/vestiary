def install_agent():
    build()
    build_host()
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>{HOST_BIN}</string>
  </array>
  <key>AssociatedBundleIdentifiers</key><array>
    <string>{HOST_BUNDLE_ID}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{LOG}</string>
  <key>StandardErrorPath</key><string>{LOG}</string>
</dict></plist>
"""
    with open(PLIST, "w") as handle:
        handle.write(plist)
    if runtime_pid() and not agent_loaded():
        pid = runtime_pid()
        os.kill(pid, signal.SIGTERM)   # hand the process over to launchd
        wait_for_host_exit()
    subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", PLIST])
    print(f"agent installed and loaded: {PLIST}")


def uninstall_agent():
    if agent_loaded():
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])
    if os.path.exists(PLIST):
        os.remove(PLIST)
    print("agent removed")


def audio_permission():
    build_host()
    print("Screen & System Audio Recording permission owner:")
    print(f"  {HOST_APP}")
    print("Grant or enable Fresco once in System Settings > "
          "Privacy & Security > Screen & System Audio Recording, then run:")
    print("  fresco restart")


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__.strip())
    command = args[0]
    if command == "set" and len(args) > 1:
        set_wallpaper(args[1])
    elif command == "repose":
        repose(args[1:])
    elif command == "repose-bg":
        repose_bg(args[1:])
    elif command == "repose-look":
        repose_look(args[1:])
    elif command == "repose-viz":
        repose_axis(args[1:], "viz", ("strings", "spectrum"), command)
    elif command == "repose-variant":
        repose_axis(args[1:], "variant", ("quiet", "loud"), command)
    elif command == "repose-grade":
        repose_axis(args[1:], "grade", ("on", "off"), command)
    elif command == "repose-night":
        repose_axis(args[1:], "night", ("on", "off"), command)
    elif command == "repose-pixels":
        repose_axis(args[1:], "pixels", ("on", "off"), command)
    elif command == "repose-label":
        repose_label(args[1:])
    elif command == "repose-pool":
        repose_pool(args[1:])
    elif command == "repose-state":
        print(json.dumps(load_repose_state(), sort_keys=True))
    elif command == "repose-add":
        repose_add(args[1:])
    elif command == "lock-bg":
        lock_bg(args[1:])
    elif command == "clear":
        clear()
    elif command == "start":
        start()
    elif command == "stop":
        stop()
    elif command == "restart":
        stop()
        start()
    elif command == "mute" and len(args) <= 2:
        if len(args) == 1:
            set_muted()
        elif args[1] == "on":
            set_muted(True)
        elif args[1] == "off":
            set_muted(False)
        else:
            sys.exit("usage: fresco mute [on|off]")
    elif command == "unmute" and len(args) == 1:
        set_muted(False)
    elif command == "status":
        status()
    elif command == "build":
        build(force=True)
        print(BIN)
    elif command == "scene-build":
        build_scene_helper(force=True)
        print(SCENE_BIN)
    elif command == "scene-samples" and len(args) == 1:
        scene_samples()
    elif command == "scene-assets":
        scene_assets(args[1:])
    elif command == "audit":
        audit(args[1:])
    elif command == "property":
        property_command(args[1:])
    elif command == "audio-permission":
        audio_permission()
    elif command == "install-agent":
        install_agent()
    elif command == "uninstall-agent":
        uninstall_agent()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
