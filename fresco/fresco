def build(force=False):
    os.makedirs(os.path.dirname(BIN), exist_ok=True)
    if (not force and os.path.exists(BIN)
            and os.path.getmtime(BIN) >= max(
                os.path.getmtime(source) for source in RUNTIME_SOURCES)):
        return
    print("compiling runtime…")
    subprocess.run(
        ["swiftc", "-O", "-warnings-as-errors",
         "-framework", "AppKit", "-framework", "WebKit",
         "-framework", "AVFoundation", "-framework", "JavaScriptCore",
         *RUNTIME_SOURCES, "-o", BIN],
        check=True)


def scene_helper_source_mtime():
    paths = []
    for root, directories, names in os.walk(SCENE_SOURCE_DIR):
        directories[:] = [name for name in directories if name != "build"]
        paths.extend(
            os.path.join(root, name)
            for name in names
            if name == "CMakeLists.txt"
            or name.endswith((".cmake", ".c", ".cpp", ".h", ".mm")))
    try:
        return max(os.path.getmtime(path) for path in paths)
    except (OSError, ValueError):
        return 0


def build_scene_helper(force=False):
    if not os.path.isfile(os.path.join(SCENE_SOURCE_DIR, "CMakeLists.txt")):
        sys.exit(f"scene-helper source unavailable: {SCENE_SOURCE_DIR}")
    source_mtime = scene_helper_source_mtime()
    if (not force and os.path.isfile(SCENE_BIN)
            and os.path.getmtime(SCENE_BIN) >= source_mtime):
        return

    print("compiling scene helper…")
    os.makedirs(SCENE_BUILD_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(SCENE_BIN), exist_ok=True)
    try:
        subprocess.run(
            ["cmake", "-S", SCENE_SOURCE_DIR, "-B", SCENE_BUILD_DIR,
             "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF",
             "-DFRESCO_SCENE_RENDER_BACKEND=native-opengl",
             "-DFRESCO_SCENE_BUILD_RENDERER="
             + ("OFF" if os.environ.get("FRESCO_SCENE_INSPECTION_ONLY") else "ON"),
             f"-DCMAKE_INSTALL_PREFIX={STATE_DIR}"],
            check=True)
        subprocess.run(
            ["cmake", "--build", SCENE_BUILD_DIR, "--target", "fresco-scene",
             "--parallel"],
            check=True)
        subprocess.run(
            ["cmake", "--install", SCENE_BUILD_DIR],
            check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"scene-helper build failed: {error}")
    if not os.path.isfile(SCENE_BIN) or not os.access(SCENE_BIN, os.X_OK):
        sys.exit(f"scene-helper install missing executable: {SCENE_BIN}")


def scene_helper_request(command):
    build_scene_helper()
    stop = {"protocolVersion": 1, "type": "stop",
            "assignmentID": "fresco-cli-stop"}
    try:
        result = subprocess.run(
            [SCENE_BIN],
            input=json.dumps(command) + "\n" + json.dumps(stop) + "\n",
            text=True,
            capture_output=True,
            timeout=15)
    except (OSError, subprocess.TimeoutExpired) as error:
        sys.exit(f"scene helper did not respond: {error}")
    if result.returncode != 0:
        sys.exit(result.stderr.strip() or
                 f"scene helper exited {result.returncode}")
    try:
        events = [json.loads(line) for line in result.stdout.splitlines()]
    except ValueError as error:
        sys.exit(f"scene helper emitted invalid protocol JSON: {error}")
    if len(events) != 2 or events[-1].get("type") != "stopped":
        sys.exit("scene helper did not complete the request cleanly")
    if result.stderr:
        sys.exit(f"scene helper wrote unexpected diagnostics: {result.stderr.strip()}")
    return events[0]


def validate_scene_assets(path):
    return scene_helper_request({
        "protocolVersion": 1,
        "type": "validate-assets",
        "assignmentID": "fresco-cli-assets",
        "path": os.path.abspath(os.path.expanduser(path)),
    })


def configured_scene_assets():
    try:
        value = open(SCENE_ASSETS).read().strip()
        return value or None
    except OSError:
        return None


def save_scene_assets(path):
    os.makedirs(STATE_DIR, exist_ok=True)
    temporary = f"{SCENE_ASSETS}.tmp.{os.getpid()}"
    try:
        with open(temporary, "w") as handle:
            handle.write(path + "\n")
        os.replace(temporary, SCENE_ASSETS)
    finally:
        try:
            if os.path.exists(temporary):
                os.remove(temporary)
        except OSError:
            pass


def scene_assets(args):
    action = args[0] if args else "status"
    if action == "status" and len(args) <= 1:
        path = configured_scene_assets()
        if not path:
            print("scene assets: (not configured)")
            return
        result = validate_scene_assets(path)
        if result.get("type") == "assets-validated":
            print(f"scene assets: valid ({result['path']})")
            return
        print(f"scene assets: invalid ({path})")
        for missing in result.get("missing", []):
            print(f"  missing: {missing}")
        return

    if action in ("set", "validate") and len(args) == 2:
        result = validate_scene_assets(args[1])
        if result.get("type") != "assets-validated":
            missing = result.get("missing", [])
            detail = (f"missing {len(missing)} required asset(s)"
                      if missing else result.get("message", "invalid asset root"))
            sys.exit(f"Wallpaper Engine assets rejected: {detail}")
        if action == "set":
            save_scene_assets(result["path"])
            print(f"scene assets set: {result['path']}")
        else:
            print(f"scene assets valid: {result['path']}")
        return

    if action == "clear" and len(args) == 1:
        try:
            os.remove(SCENE_ASSETS)
            print("scene assets cleared")
        except FileNotFoundError:
            print("scene assets already clear")
        return

    sys.exit("usage: fresco scene-assets [status|set <path>|validate <path>|clear]")


def scene_samples():
    if not os.path.isfile(SCENE_FIXTURES):
        sys.exit(f"scene fixture manifest unavailable: {SCENE_FIXTURES}")
    if not os.path.isfile(LIVERYCTL) or not os.access(LIVERYCTL, os.X_OK):
        sys.exit(f"livery control unavailable: {LIVERYCTL}")
    if shutil.which("ffmpeg") is None:
        sys.exit("scene sample extraction requires ffmpeg")

    with open(SCENE_FIXTURES, encoding="utf-8") as handle:
        fixtures = json.load(handle)["items"]
    missing = [
        fixture["id"]
        for fixture in fixtures
        if not os.path.isfile(os.path.join(WORKSHOP_DIR, fixture["id"], "project.json"))
    ]
    if missing:
        sys.exit("scene sample packages missing: " + ", ".join(missing))

    imported = []
    with tempfile.TemporaryDirectory(prefix="fresco-scene-samples.") as temporary:
        for fixture in fixtures:
            root = os.path.join(WORKSHOP_DIR, fixture["id"])
            with open(os.path.join(root, "project.json"), encoding="utf-8") as handle:
                project = json.load(handle)
            candidates = [
                project.get("preview"),
                "preview.gif",
                "preview.jpg",
                "preview.png",
            ]
            preview = next(
                (
                    os.path.join(root, candidate)
                    for candidate in candidates
                    if candidate and os.path.isfile(os.path.join(root, candidate))
                ),
                None,
            )
            if preview is None:
                sys.exit(f"scene sample preview missing: {fixture['id']}")

            frame = os.path.join(temporary, f"{fixture['id']}.png")
            extraction = subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-v",
                    "error",
                    "-i",
                    preview,
                    "-vf",
                    "thumbnail=100",
                    "-frames:v",
                    "1",
                    frame,
                ],
                capture_output=True,
                text=True,
            )
            if extraction.returncode != 0 or not os.path.isfile(frame):
                detail = extraction.stderr.strip() or "frame extraction failed"
                sys.exit(f"scene sample {fixture['id']}: {detail}")

            coverage = fixture["picker"]
            command = [
                LIVERYCTL,
                "import-wallpaper",
                frame,
                "--name",
                fixture["title"],
                "--subtitle",
                f"scene / {coverage['status']}",
                "--credit",
                fixture["workshopURL"],
                "--scene-coverage",
                coverage["status"],
                "--scene-note",
                coverage["note"],
            ]
            if coverage["status"] != "not-yet-possible":
                command.extend(["--live-reference", root])
            result = subprocess.run(command, capture_output=True, text=True)
            if result.returncode != 0:
                detail = (result.stderr or result.stdout).strip() or "import failed"
                sys.exit(f"scene sample {fixture['id']}: {detail}")
            try:
                record = json.loads(result.stdout)
            except ValueError as error:
                sys.exit(f"scene sample {fixture['id']}: invalid livery record: {error}")
            imported.append(record["id"])
            print(f"scene sample: {coverage['status']} · {fixture['title']}")

    print(f"scene samples added to Livery: {len(imported)}")


def host_valid():
    """The host's exact bits are its rebuild-stable TCC identity."""
    if not os.path.isfile(HOST_BIN) or not os.access(HOST_BIN, os.X_OK):
        return False
    verification = subprocess.run(
        ["codesign", "--verify", "--strict", HOST_APP],
        capture_output=True)
    identifier = subprocess.run(
        ["plutil", "-extract", "CFBundleIdentifier", "raw", "-o", "-",
         os.path.join(HOST_APP, "Contents", "Info.plist")],
        capture_output=True, text=True)
    return (verification.returncode == 0
            and identifier.stdout.strip() == HOST_BUNDLE_ID)


def build_host(force=False):
    """Install the stable responsible app once.

    Ordinary renderer rebuilds deliberately never touch this bundle: an ad-hoc
    signature identifies one exact build, so preserving the host preserves its
    Screen & System Audio Recording grant. Force is an explicit identity reset.
    """
    if not force and host_valid():
        return
    if os.path.exists(HOST_APP):
        shutil.rmtree(HOST_APP)
    contents = os.path.join(HOST_APP, "Contents")
    os.makedirs(os.path.join(contents, "MacOS"), exist_ok=True)
    shutil.copy2(HOST_INFO, os.path.join(contents, "Info.plist"))
    subprocess.run(
        ["swiftc", "-O", "-warnings-as-errors", HOST_SOURCE, "-o", HOST_BIN],
        check=True)
    subprocess.run(
        ["codesign", "--force", "--sign", "-", "--identifier", HOST_BUNDLE_ID,
         HOST_APP], check=True, capture_output=True)
    if not host_valid():
        sys.exit(f"installed wallpaper host failed signature validation: {HOST_APP}")
    print(f"installed stable permission host: {HOST_APP}")


def runtime_pid():
    try:
        pid = int(open(PIDFILE).read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def host_pid():
    try:
        pid = int(open(HOST_PIDFILE).read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def wait_for_runtime(attempts=40):
    import time
    for _ in range(attempts):
        pid = runtime_pid()
        if pid:
            return pid
        time.sleep(0.1)
    return None


def wait_for_host_exit(attempts=40):
    import time
    for _ in range(attempts):
        if not host_pid():
            return
        time.sleep(0.1)


def wait_for_revision(revision, attempts=120):
    import time
    for _ in range(attempts):
        try:
            with open(STATUS) as handle:
                status = json.load(handle)
        except (OSError, ValueError, TypeError):
            status = None
        if isinstance(status, dict) and status.get("desiredRevision") == revision:
            runtime = status.get("runtime", {})
            runtime_status = runtime.get("status")
            if runtime_status == "degraded":
                errors = [item.get("error") for item in runtime.get("displays", [])
                          if item.get("error")]
                detail = "; ".join(errors) or "runtime degraded"
                sys.exit(f"state revision {revision} did not converge: {detail}")
            if runtime_status in ("running", "idle"):
                return status
        time.sleep(0.1)
    sys.exit(f"timed out waiting for state revision {revision} to converge")


def state_selection(target=None, legacy_path=None):
    build()
    command = ([BIN, "--state-select", target, legacy_path]
               if target is not None else [BIN, "--state-clear"])
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        sys.exit(result.stderr.strip() or "state transaction failed")
    try:
        response = json.loads(result.stdout)
        return int(response["revision"])
    except (ValueError, TypeError, KeyError):
        sys.exit("state transaction returned an invalid response")


def state_muted(muted=None):
    build()
    value = "toggle" if muted is None else "true" if muted else "false"
    result = subprocess.run(
        [BIN, "--state-muted", value],
        capture_output=True, text=True)
    if result.returncode:
        sys.exit(result.stderr.strip() or "mute state transaction failed")
    try:
        response = json.loads(result.stdout)
        return int(response["revision"]), bool(response["muted"])
    except (ValueError, TypeError, KeyError):
        sys.exit("mute state transaction returned an invalid response")


def runtime_stale(pid):
    """True when the daemon process predates the current binary."""
    try:
        etime = subprocess.run(["ps", "-p", str(pid), "-o", "etime="],
                               capture_output=True, text=True).stdout.strip()
        parts = etime.replace("-", ":").split(":")
        seconds = 0
        for part in parts:
            seconds = seconds * 60 + int(part)
        if len(parts) == 4:   # dd:hh:mm:ss — the day field is *86400/60^3
            days, hours, minutes, secs = (int(p) for p in parts)
            seconds = days * 86400 + hours * 3600 + minutes * 60 + secs
        import time
        started = time.time() - seconds
        return os.path.getmtime(BIN) > started + 5
    except (OSError, ValueError):
        return False


