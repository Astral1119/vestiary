def resolve(target):
    if target.isdigit():
        path = os.path.join(WORKSHOP_DIR, target)
        if not os.path.exists(os.path.join(path, "project.json")):
            print(f"fetching workshop item {target}…")
            subprocess.run([os.path.join(SCRIPT_DIR, "workshop"), "get", target],
                           check=True, capture_output=True, text=True)
    else:
        path = os.path.abspath(os.path.expanduser(target))
        if not os.path.exists(path):
            sys.exit(f"no such wallpaper: {path}")
    # Preset items reference a base wallpaper; make sure it's present too.
    try:
        import json as json_module
        with open(os.path.join(path, "project.json")) as handle:
            dependency = json_module.load(handle).get("dependency")
        if dependency and not os.path.exists(
                os.path.join(WORKSHOP_DIR, str(dependency), "project.json")):
            print(f"fetching preset dependency {dependency}…")
            subprocess.run([os.path.join(SCRIPT_DIR, "workshop"), "get", str(dependency)],
                           check=True, capture_output=True, text=True)
    except (OSError, ValueError, NotADirectoryError):
        pass
    return path


def load_project(path):
    try:
        with open(os.path.join(path, "project.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError, TypeError):
        return {}


def project_resolves_web(path, seen=None):
    """Whether an installed item is a web project or a preset over one."""
    project = load_project(path)
    if "web" in str(project.get("type", "")).lower():
        return True
    dependency = project.get("dependency")
    if dependency is None:
        return False
    dependency = str(dependency)
    seen = set() if seen is None else seen
    if dependency in seen:
        return False
    seen.add(dependency)
    return project_resolves_web(os.path.join(WORKSHOP_DIR, dependency), seen)


def installed_web_projects():
    try:
        names = sorted(os.listdir(WORKSHOP_DIR))
    except OSError:
        return []
    return [os.path.join(WORKSHOP_DIR, name) for name in names
            if project_resolves_web(os.path.join(WORKSHOP_DIR, name))]


def write_json(path, value):
    temporary = path + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, path)


def audit_targets(args):
    if not args:
        args = ["current"]
    if "all" in args:
        if args != ["all"]:
            sys.exit("usage: fresco audit [all|current|<id-or-path>...]")
        targets = installed_web_projects()
        if not targets:
            sys.exit(f"no installed web projects under {WORKSHOP_DIR}")
        return targets

    targets = []
    for target in args:
        if target == "current":
            try:
                with open(CONFIG) as handle:
                    path = handle.read().strip()
            except OSError:
                path = ""
            if not path:
                sys.exit("no current wallpaper to audit")
        else:
            path = resolve(target)
        if path not in targets:
            targets.append(path)
    return targets


def audit(args):
    """Audit web projects without replacing or signaling the live wallpaper."""
    build()
    targets = audit_targets(args)
    started = datetime.now().astimezone()
    run_root = os.path.join(STATE_DIR, "audits", started.strftime("%Y%m%d-%H%M%S"))
    candidate = run_root
    suffix = 2
    while os.path.exists(candidate):
        candidate = f"{run_root}-{suffix}"
        suffix += 1
    run_root = candidate
    os.makedirs(run_root)
    summary_path = os.path.join(run_root, "summary.json")
    summary = {
        "schemaVersion": 1,
        "status": "running",
        "generatedAt": started.isoformat(timespec="seconds"),
        "runPath": run_root,
        "items": [],
    }
    write_json(summary_path, summary)

    used_names = set()
    for position, path in enumerate(targets, 1):
        project = load_project(path)
        title = str(project.get("title") or os.path.basename(path.rstrip(os.sep)))
        stem = os.path.basename(path.rstrip(os.sep))
        stem = re.sub(r"[^A-Za-z0-9._-]+", "-", stem).strip("-.") or "wallpaper"
        unique_stem = stem
        duplicate = 2
        while unique_stem in used_names:
            unique_stem = f"{stem}-{duplicate}"
            duplicate += 1
        used_names.add(unique_stem)
        report_path = os.path.join(run_root, unique_stem + ".json")
        snapshot_path = os.path.join(run_root, unique_stem + ".png")

        print(f"auditing {position}/{len(targets)}: {title}", flush=True)
        worker_stdout = ""
        worker_stderr = ""
        worker_status = 1
        try:
            result = subprocess.run(
                [BIN, "--audit-web", path, report_path, snapshot_path],
                capture_output=True, text=True, timeout=30)
            worker_status = result.returncode
            worker_stdout = result.stdout.strip()
            worker_stderr = result.stderr.strip()
        except subprocess.TimeoutExpired as error:
            worker_stderr = "audit worker exceeded 30 seconds"
            if error.stderr:
                worker_stderr += "\n" + str(error.stderr).strip()

        try:
            with open(report_path) as handle:
                report = json.load(handle)
        except (OSError, ValueError):
            report = {
                "schemaVersion": 1,
                "wallpaperPath": path,
                "snapshotPath": snapshot_path,
                "verdict": "fail",
                "failureReasons": ["audit worker did not produce a report"],
            }
            write_json(report_path, report)

        verdict = report.get("verdict", "fail")
        if worker_status != 0 and verdict != "fail":
            verdict = "fail"
            report["verdict"] = verdict
            reasons = report.setdefault("failureReasons", [])
            reasons.append("audit worker exited unsuccessfully")
            write_json(report_path, report)
        detail = report.get("failureReasons") or report.get("warnings") or []
        suffix_text = f" — {'; '.join(detail)}" if detail else ""
        print(f"{verdict.upper():7} {unique_stem}: {title}{suffix_text}")

        item = {
            "id": unique_stem,
            "title": title,
            "wallpaperPath": path,
            "reportPath": report_path,
            "snapshotPath": snapshot_path,
            "verdict": verdict,
            "workerExitStatus": worker_status,
        }
        if worker_stdout:
            item["workerStdout"] = worker_stdout
        if worker_stderr:
            item["workerStderr"] = worker_stderr
        summary["items"].append(item)
        write_json(summary_path, summary)

    counts = {verdict: sum(item["verdict"] == verdict for item in summary["items"])
              for verdict in ("pass", "warning", "fail")}
    summary["counts"] = counts
    summary["status"] = "complete"
    summary["completedAt"] = datetime.now().astimezone().isoformat(timespec="seconds")
    write_json(summary_path, summary)
    print(f"audit summary: {summary_path}")
    print(f"{counts['pass']} passed, {counts['warning']} warned, {counts['fail']} failed")
    if counts["fail"]:
        sys.exit(1)


PROPERTY_ACTIONS = {"describe", "get", "list", "reset", "set"}
PROPERTY_TYPES = {"bool", "color", "combo", "directory", "file",
                  "slider", "textinput"}


def read_current_wallpaper_path():
    try:
        with open(CONFIG) as handle:
            path = handle.read().strip()
    except OSError:
        path = ""
    return path


def current_wallpaper_path():
    path = read_current_wallpaper_path()
    if not path:
        sys.exit("no current wallpaper")
    return path


def describe_project(path):
    build()
    result = subprocess.run([BIN, "--describe-project", path],
                            capture_output=True, text=True)
    if result.returncode:
        sys.exit(result.stderr.strip() or "wallpaper has no supported project properties")
    try:
        return json.loads(result.stdout)
    except ValueError:
        sys.exit("property descriptor returned invalid JSON")


def property_target(target):
    return resolve(current_wallpaper_path() if target == "current" else target)


def property_definition(description, requested_name):
    requested = requested_name.lower()
    matches = [item for item in description["presentation"]
               if item.get("name", "").lower() == requested]
    if not matches:
        sys.exit(f"unknown property: {requested_name}")
    return matches[0]


def parse_property_value(definition, raw):
    property_type = definition.get("type", "").lower()
    name = definition.get("name", "property")
    if property_type not in PROPERTY_TYPES:
        sys.exit(f"property is not editable: {name} ({property_type or 'no type'})")

    if property_type == "bool":
        normalized = raw.lower()
        if normalized in ("true", "on", "yes", "1"):
            return True
        if normalized in ("false", "off", "no", "0"):
            return False
        sys.exit(f"{name} expects true or false")

    if property_type == "slider":
        try:
            value = float(raw)
        except ValueError:
            sys.exit(f"{name} expects a number")
        if not math.isfinite(value):
            sys.exit(f"{name} expects a finite number")
        minimum = definition.get("min")
        maximum = definition.get("max")
        if minimum is not None and value < float(minimum):
            sys.exit(f"{name} must be at least {minimum}")
        if maximum is not None and value > float(maximum):
            sys.exit(f"{name} must be at most {maximum}")
        return int(value) if value.is_integer() else value

    if property_type == "color":
        if re.fullmatch(r"#[0-9A-Fa-f]{6}", raw):
            channels = [int(raw[index:index + 2], 16) / 255
                        for index in (1, 3, 5)]
        else:
            try:
                channels = [float(channel) for channel in raw.split()]
            except ValueError:
                channels = []
        if len(channels) != 3 or any(not math.isfinite(channel)
                                     or channel < 0 or channel > 1
                                     for channel in channels):
            sys.exit(f"{name} expects #RRGGBB or three values from 0 to 1")
        return " ".join(f"{channel:.6g}" for channel in channels)

    if property_type == "combo":
        try:
            candidate = json.loads(raw)
        except ValueError:
            candidate = raw
        options = definition.get("options", [])
        for option in options:
            option_value = option.get("value")
            if (type(candidate) is type(option_value) and candidate == option_value
                    or raw == str(option_value)):
                return option_value
        if options:
            choices = ", ".join(str(option.get("value")) for option in options)
            sys.exit(f"{name} expects one of: {choices}")
        return candidate

    if property_type in ("file", "directory"):
        path = os.path.realpath(os.path.abspath(os.path.expanduser(raw)))
        expected = os.path.isfile if property_type == "file" else os.path.isdir
        if not expected(path):
            sys.exit(f"{name} expects an existing {property_type}: {path}")
        if property_type == "file":
            file_type = str(definition.get("fileType", "")).lower()
            extension = os.path.splitext(path)[1].lower().lstrip(".")
            image_extensions = {"bmp", "gif", "jpeg", "jpg", "png", "pnga",
                                "svg", "webp"}
            video_extensions = {"m4v", "mov", "mp4", "ogg", "ogv", "webm"}
            allowed = (video_extensions if "video" in file_type
                       else image_extensions if "image" in file_type else None)
            if allowed is not None and extension not in allowed:
                sys.exit(f"{name} does not accept .{extension or '(none)'} files")
        return path

    return raw


def property_record(description):
    path = description["statePath"]
    try:
        with open(path) as handle:
            record = json.load(handle)
    except (OSError, ValueError, TypeError):
        record = {}
    values = record.get("values")
    if not isinstance(values, dict):
        values = {}
    return path, values


def save_property_record(description, values):
    path = description["statePath"]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_json(path, {
        "schemaVersion": 1,
        "wallpaperPath": description["wallpaperPath"],
        "title": description["title"],
        "updatedAt": datetime.now().astimezone().isoformat(timespec="seconds"),
        "values": values,
    })


def apply_property_state(path):
    pid = runtime_pid()
    if not pid:
        print("stored; runtime is not running")
        return
    if runtime_stale(pid):
        print("runtime binary is newer than the daemon — restarting")
        os.kill(pid, signal.SIGTERM)
        import time
        for _ in range(30):
            if not runtime_pid():
                break
            time.sleep(0.1)
        wait_for_host_exit()
        start()
        print("properties loaded by restarted runtime")
        return
    os.kill(pid, signal.SIGHUP)
    print("property refresh signaled")


def clean_property_label(raw):
    text = re.sub(r"<[^>]*>", " ", unescape(str(raw)))
    return re.sub(r"\s+", " ", text).strip()


def property_list(description):
    print(f"{description['title']} ({description['stateID']})")
    if description.get("locale"):
        print(f"locale: {description['locale']}")
    for item in description["presentation"]:
        if not item.get("editable"):
            continue
        active = item.get("active")
        if not item.get("runtimeSupported", True):
            state = "unsupported"
        else:
            state = "active" if active is True else "inactive" if active is False else "unknown"
        value = json.dumps(item.get("value"), ensure_ascii=False)
        label = clean_property_label(item.get("label") or item["name"])
        print(f"{item['name']}\t{item['type']}\t{state}\t{value}\t{label}")


def property_command(args):
    usage = ("usage: fresco property [<id-or-path>] "
             "<list|describe|get NAME|set NAME VALUE|reset [NAME]>")
    if not args:
        sys.exit(usage)
    if args[0] in PROPERTY_ACTIONS:
        target = "current"
        action = args[0]
        action_args = args[1:]
    elif len(args) >= 2 and args[1] in PROPERTY_ACTIONS:
        target = args[0]
        action = args[1]
        action_args = args[2:]
    else:
        sys.exit(usage)

    path = property_target(target)
    description = describe_project(path)
    if action == "describe":
        if action_args:
            sys.exit(usage)
        print(json.dumps(description, indent=2, sort_keys=True, ensure_ascii=False))
        return
    if action == "list":
        if action_args:
            sys.exit(usage)
        property_list(description)
        return
    if action == "get":
        if len(action_args) != 1:
            sys.exit(usage)
        definition = property_definition(description, action_args[0])
        print(json.dumps(definition, indent=2, sort_keys=True, ensure_ascii=False))
        return

    _, values = property_record(description)
    if action == "set":
        if len(action_args) != 2:
            sys.exit(usage)
        definition = property_definition(description, action_args[0])
        name = definition["name"]
        values[name] = parse_property_value(definition, action_args[1])
        save_property_record(description, values)
        print(f"stored {name} = {json.dumps(values[name], ensure_ascii=False)}")
    elif action == "reset":
        if len(action_args) > 1:
            sys.exit(usage)
        if action_args:
            definition = property_definition(description, action_args[0])
            name = definition["name"]
            values.pop(name, None)
            print(f"reset {name}")
        else:
            values = {}
            print("reset all persisted properties")
        save_property_record(description, values)
    apply_property_state(path)


def start():
    build()
    build_host()
    os.makedirs(STATE_DIR, exist_ok=True)
    if runtime_pid():
        print("already running")
        return
    if agent_installed():
        if agent_loaded():
            subprocess.run(["launchctl", "kickstart", f"gui/{os.getuid()}/{LABEL}"])
        else:
            subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", PLIST])
        print("started (launchd)")
        return
    # LaunchServices makes the stable app bundle the responsible process for
    # privacy attribution. The mutable renderer runs beneath it as a child.
    subprocess.run(["open", "-gj", HOST_APP], check=True)
    if not wait_for_runtime():
        sys.exit(f"stable host did not start the runtime; check {LOG}")
    print(f"started (stable host; log: {LOG})")


def stop():
    if agent_loaded():
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])
        print("stopped (agent unloaded; `start` reloads it)")
        return
    pid = runtime_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        # SIGTERM is async — wait for the exit so a follow-up start()
        # doesn't see the dying process and skip launching (restart race)
        import time
        for _ in range(30):
            if not runtime_pid():
                break
            time.sleep(0.1)
        wait_for_host_exit()
        print("stopped")
    else:
        print("not running")


def set_wallpaper(target):
    path = resolve(target)
    os.makedirs(STATE_DIR, exist_ok=True)
    if "scene" in str(load_project(path).get("type", "")).lower():
        build_scene_helper()
    revision = state_selection(target, path)
    pid = runtime_pid()
    if pid and runtime_stale(pid):
        print("runtime binary is newer than the daemon — restarting")
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not runtime_pid():
                break
            import time
            time.sleep(0.1)
        wait_for_host_exit()
        pid = None
    if pid:
        os.kill(pid, signal.SIGUSR1)
    else:
        start()
    wait_for_revision(revision)
    print(f"set revision {revision}: {path}")


REPOSE_STATE = os.path.join(STATE_DIR, "repose.json")
SCENES_DIR = os.path.join(STATE_DIR, "scenes")


def repose_scene_entries():
    """The catalog as (stable-id, runtime-path), in its fallback order."""
    entries = [("desktop", "desktop")]
    try:
        names = sorted(name for name in os.listdir(SCENES_DIR)
                       if not name.startswith("."))
    except OSError:
        return entries
    for name in names:
        path = os.path.join(SCENES_DIR, name)
        if os.path.isdir(path):
            if os.path.isfile(os.path.join(path, "project.json")):
                entries.append((name, path))
        elif os.path.splitext(name)[1].lower() in (".mp4", ".mov", ".m4v"):
            entries.append((name, path))
    return entries


def repose_scene_id(scene):
    return "desktop" if scene == "desktop" else os.path.basename(scene.rstrip(os.sep))


def load_repose_state():
    state = {"look": "zephyr", "scene": "desktop", "viz": "strings",
             "variant": "quiet",
             "grade": "on", "night": "off", "pixels": "on", "label": "on"}
    try:
        with open(REPOSE_STATE) as handle:
            state.update(json.load(handle))
    except (OSError, ValueError):
        pass
    # Backward compatibility: absence means every catalog scene in the same
    # deterministic order the cover used before ordered rotations existed.
    if "scenePool" not in state:
        state["scenePool"] = [scene_id for scene_id, _ in repose_scene_entries()]
    return state


def save_repose_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(REPOSE_STATE, "w") as handle:
        json.dump(state, handle, indent=2, sort_keys=True)
        handle.write("\n")


def signal_repose(verb):
    """Write the command file and signal the daemon (starting it if the verb
    needs a cover; a refresh with no daemon just applies at next entry)."""
    build()
    os.makedirs(STATE_DIR, exist_ok=True)
    path = os.path.join(SCRIPT_DIR, "repose")
    with open(os.path.join(STATE_DIR, "repose-command"), "w") as handle:
        handle.write(f"{verb}\n{path}\n")
    pid = runtime_pid()
    if pid and runtime_stale(pid):
        print("runtime binary is newer than the daemon — restarting")
        os.kill(pid, signal.SIGTERM)
        import time
        for _ in range(20):
            if not runtime_pid():
                break
            time.sleep(0.1)
        wait_for_host_exit()
        pid = None
    if not pid:
        if verb in ("exit", "refresh"):
            return
        start()
        import time
        for _ in range(30):
            pid = runtime_pid()
            if pid:
                break
            time.sleep(0.1)
    if not pid:
        sys.exit("runtime did not start; check the log")
    os.kill(pid, signal.SIGUSR2)


def repose(args):
    action = args[0] if args else "toggle"
    if action not in ("quiet", "loud", "off", "toggle"):
        sys.exit("usage: fresco repose [quiet|loud|off]")
    if action in ("quiet", "loud"):
        state = load_repose_state()
        state["variant"] = action
        save_repose_state(state)
    verb = ("exit" if action == "off"
            else "enter" if action in ("quiet", "loud") else "toggle")
    signal_repose(verb)
    print(f"repose: {verb}" + (f" ({action})" if action in ("quiet", "loud") else ""))


def repose_bg(args):
    """Set the cover scene in repose.json; applies live if covered."""
    state = load_repose_state()
    if not args:
        scene = state["scene"]
        print(f"repose scene: {scene if scene != 'desktop' else '(mirrors the desktop wallpaper)'}")
        return
    if args[0] in ("desktop", "off"):
        state["scene"] = "desktop"
    else:
        state["scene"] = resolve(args[0])
    scene_id = repose_scene_id(state["scene"])
    if scene_id not in state["scenePool"]:
        state["scenePool"].append(scene_id)
    save_repose_state(state)
    signal_repose("refresh")
    print(f"repose scene: {state['scene']}")


def repose_look(args):
    """Set the composition language in repose.json; applies live if covered."""
    state = load_repose_state()
    if not args:
        print(f"repose look: {state['look']}")
        return
    if args[0] not in ("zephyr", "pixel"):
        sys.exit("usage: fresco repose-look <zephyr|pixel>")
    state["look"] = args[0]
    save_repose_state(state)
    signal_repose("refresh")
    print(f"repose look: {state['look']}")


def repose_axis(args, key, choices, command):
    """Read or immediately persist one Repose axis without entering cover."""
    state = load_repose_state()
    if not args:
        print(f"repose {key}: {state.get(key)}")
        return
    if args[0] not in choices:
        sys.exit(f"usage: fresco {command} <{'|'.join(choices)}>")
    state[key] = args[0]
    save_repose_state(state)
    signal_repose("refresh")
    print(f"repose {key}: {state[key]}")


def repose_pool(args):
    """Persist the ordered, non-empty rotation without selecting a scene."""
    state = load_repose_state()
    if not args:
        print(json.dumps(state["scenePool"]))
        return
    available = dict(repose_scene_entries())
    ordered = []
    for scene_id in args:
        if scene_id not in available:
            sys.exit(f"no Repose scene id: {scene_id}")
        if scene_id not in ordered:
            ordered.append(scene_id)
    if not ordered:
        sys.exit("Repose rotation must contain at least one scene")
    state["scenePool"] = ordered
    current_id = repose_scene_id(state.get("scene", "desktop"))
    if current_id not in ordered:
        state["scene"] = available[ordered[0]]
    save_repose_state(state)
    signal_repose("refresh")
    print(f"repose rotation: {len(ordered)} scene(s)")


def repose_add(args):
    """Add a live wallpaper to the shared Repose scene directory.

    Deliberately additive: curation/removal remains outside this phase.
    """
    if not args:
        sys.exit("usage: fresco repose-add <path-or-workshop-id>")
    source = resolve(args[0])
    title = os.path.basename(source.rstrip(os.sep))
    if os.path.isfile(source):
        title = os.path.splitext(title)[0]
    try:
        with open(os.path.join(source, "project.json")) as handle:
            title = json.load(handle).get("title", title)
    except (OSError, ValueError, AttributeError):
        pass
    stem = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-") or "scene"
    os.makedirs(SCENES_DIR, exist_ok=True)
    destination = os.path.join(SCENES_DIR, stem)
    suffix = 2
    while os.path.lexists(destination):
        if os.path.realpath(destination) == os.path.realpath(source):
            print(f"repose library: already added ({destination})")
            return
        destination = os.path.join(SCENES_DIR, f"{stem}-{suffix}")
        suffix += 1
    os.symlink(source, destination, target_is_directory=os.path.isdir(source))
    print(f"repose library: added {destination}")


def lock_bg(args):
    """Set the lock-screen wallpaper. The runtime covers the desktop, so
    the macOS system wallpaper (which the lock screen mirrors) is only
    ever visible while locked — setting it via Livery's store engine is
    the lock-screen split. 'theme' restores the current Livery still."""
    if not os.path.isfile(LIVERY_ENGINE):
        sys.exit(f"livery wallpaper engine not built: {LIVERY_ENGINE}")
    if not args:
        result = subprocess.run([LIVERY_ENGINE, "status"],
                                capture_output=True, text=True)
        try:
            print(f"lock wallpaper: {json.loads(result.stdout)['imagePath']}")
        except (ValueError, KeyError):
            sys.exit(result.stderr.strip() or "wallpaper engine gave no status")
        return
    if args[0] == "theme":
        try:
            with open(os.path.join(LIVERY_ROOT, "state.json")) as handle:
                current = json.load(handle)["current"]
        except (OSError, ValueError, KeyError):
            sys.exit("no Livery state to restore from")
        wallpaper_dir = os.path.join(LIVERY_ROOT, current, "wallpaper")
        stills = sorted(
            os.path.join(wallpaper_dir, name)
            for name in (os.listdir(wallpaper_dir)
                         if os.path.isdir(wallpaper_dir) else [])
            if name.lower().endswith((".png", ".jpg", ".jpeg", ".heic")))
        if not stills:
            sys.exit(f"current Livery profile has no wallpaper still: {wallpaper_dir}")
        image = stills[0]
    else:
        image = os.path.abspath(args[0])
        if not os.path.isfile(image):
            sys.exit(f"no such image: {image}")
    subprocess.run([LIVERY_ENGINE, "apply-global", image], check=True)
    print(f"lock wallpaper: {image}")


def repose_label(args):
    """Toggle the scene-name label in repose.json; applies live if covered."""
    state = load_repose_state()
    if not args:
        print(f"repose label: {state.get('label', 'on')}")
        return
    if args[0] not in ("on", "off"):
        sys.exit("usage: fresco repose-label [on|off]")
    state["label"] = args[0]
    save_repose_state(state)
    signal_repose("refresh")
    print(f"repose label: {state['label']}")


